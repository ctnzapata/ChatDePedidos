# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# --- Base de datos: Supabase (Postgres) ---
# En Supabase: Project Settings > Database > Connection string.
# App: "Transaction pooler" (puerto 6543), con ?pgbouncer=true al final.
DATABASE_URL="postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migraciones: "Session pooler" o conexión directa (puerto 5432).
DIRECT_URL="postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase Auth y Realtime (para el panel; se usan desde la Fase 3) ---
# Project Settings > API: "Project URL" y la llave "publishable" (pública, puede ir en el navegador).
SUPABASE_URL="https://TU_PROYECTO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Llave "secret": SOLO servidor (invitar usuarios). Nunca en el navegador ni en git.
SUPABASE_SECRET_KEY="sb_secret_..."

# --- Proveedor de IA: "anthropic" (Claude) o "gemini" (Google) ---
LLM_PROVIDER="anthropic"

# --- Gemini (Google AI Studio) ---
# Crea la key en https://aistudio.google.com/apikey. Solo se usa con LLM_PROVIDER="gemini".
# Ojo: en el plan gratuito Google puede usar los datos para mejorar sus productos (no uses datos reales de clientes).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# --- Claude (Anthropic) ---
# Crea la clave en https://console.anthropic.com y fija un límite de gasto mensual.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"
# Tope de tokens de salida por respuesta del agente (WhatsApp usa mensajes cortos).
AGENT_MAX_OUTPUT_TOKENS=1024
# Máximo de llamadas al modelo por cada mensaje del cliente (corta bucles de herramientas).
AGENT_MAX_ITERATIONS=6
# Cuántos mensajes del historial se envían al modelo.
AGENT_HISTORY_LIMIT=20

# --- WhatsApp Cloud API (Meta) ---
# Solo se necesitan para el servidor (npm run dev), no para el simulador (npm run chat).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
# Cadena que tú inventas y pegas también en el panel de Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v23.0"

# --- Seed del restaurante (npm run db:setup) ---
# phone_number_id del número de prueba (panel de Meta > WhatsApp > API Setup).
SEED_WHATSAPP_PHONE_NUMBER_ID=""
# WhatsApp del personal que recibe avisos de pedidos (formato 57300xxxxxxx, sin "+"). Opcional.
SEED_STAFF_PHONE=""

# --- Panel del restaurante ---
PANEL_USER="admin"
PANEL_PASSWORD=""

# --- Servidor ---
PORT=3000
LOG_LEVEL="info"
# Nivel de logs del simulador (npm run chat); "info" muestra el uso de tokens por turno.
LOG_LEVEL_SIMULATOR="warn"
